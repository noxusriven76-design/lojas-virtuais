APP_NAME=Loja Platform API
ENV=dev
DEBUG=true

# MySQL (DEV)
# Use strong credentials locally; do NOT commit a real .env.
MYSQL_DATABASE=loja
MYSQL_USER=loja
MYSQL_PASSWORD=change-me-strong
MYSQL_ROOT_PASSWORD=change-me-strong-root

# API DB connection string
# - When running via docker-compose.dev.yml, use host "mysql".
# - When running locally (no docker), you can use 127.0.0.1.
DATABASE_URL=mysql+pymysql://loja:change-me-strong@mysql:3306/loja?charset=utf8mb4

# Optional multi-DB router (Phase 3 infra)
# Keep disabled until Phase 4/5 cutover.
DB_ROUTER_ENABLED=false
DB_ROUTER_LOG=true
DB_ROUTER_FALLBACK_LEGACY=true
DB_ROUTER_DEFAULT_TARGET=legacy

# Optional dedicated core DB (defaults to DATABASE_URL when empty)
DATABASE_URL_CORE=

# Tenant DB mapping by store slug.
# Preferred JSON:
# TENANT_DATABASE_URLS={"roupas":"mysql+pymysql://...","relogios":"mysql+pymysql://...","agro":"mysql+pymysql://..."}
# Alternative format:
# TENANT_DATABASE_URLS=roupas=mysql+pymysql://...;relogios=mysql+pymysql://...;agro=mysql+pymysql://...
TENANT_DATABASE_URLS=

# Phase 5 cutover control by store slug.
# Modes: legacy | tenant
# Preferred JSON:
# STORE_DB_CUTOVER_MAP={"agro":"tenant","roupas":"legacy","relogios":"legacy"}
# Alternative format:
# STORE_DB_CUTOVER_MAP=agro=tenant;roupas=legacy;relogios=legacy
STORE_DB_CUTOVER_MAP=

# Post-cutover target profile (reference):
# DB_ROUTER_ENABLED=true
# DB_ROUTER_FALLBACK_LEGACY=false
# DB_ROUTER_DEFAULT_TARGET=tenant
# STORE_DB_CUTOVER_MAP={"agro":"tenant","roupas":"tenant","relogios":"tenant"}

JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_PASSWORD_MIN_LENGTH=8
ADMIN_PASSWORD_MAX_AGE_DAYS=0
ADMIN_LOGIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=15

# Payments webhook (provider => secret)
# JSON preferred: {"mercadopago":"secret-a","stripe":"secret-b"}
PAYMENT_WEBHOOK_SECRETS=

# Comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local uploads
# - UPLOADS_DIR can be absolute or relative to backend/.
# - UPLOADS_BASE_URL is the public static mount path.
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=/static/uploads
UPLOADS_MAX_SIZE_BYTES=5242880

# When using multi-tenant endpoints without explicit store context:
# - If exactly one active store exists, it will be used.
# - Otherwise the API will require store_id/store_slug.
