APP_NAME=Loja Platform API
ENV=dev
DEBUG=true

# MySQL (DEV)
# Use strong credentials locally; do NOT commit a real .env.
MYSQL_DATABASE=loja
MYSQL_USER=loja
MYSQL_PASSWORD=change-me-strong
MYSQL_ROOT_PASSWORD=change-me-strong-root

# API DB connection string
# - When running via docker-compose.dev.yml, use host "mysql".
# - When running locally (no docker), you can use 127.0.0.1.
DATABASE_URL=mysql+pymysql://loja:change-me-strong@mysql:3306/loja?charset=utf8mb4

JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Local uploads
# - UPLOADS_DIR can be absolute or relative to backend/.
# - UPLOADS_BASE_URL is the public static mount path.
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=/static/uploads
UPLOADS_MAX_SIZE_BYTES=5242880

# When using multi-tenant endpoints without explicit store context:
# - If exactly one active store exists, it will be used.
# - Otherwise the API will require store_id/store_slug.
